# Slack Bot Token (xoxb-...) — requires scopes: users:read, users:read.email
SLACK_BOT_TOKEN=xoxb-your-token-here

# API endpoint that returns a JSON array of user objects with an "email" field
API_ENDPOINT_URL=https://your-api.example.com/users

# AEM on-prem / local settings
AEM_URL=http://localhost:4502
AEM_USERNAME=admin
AEM_PASSWORD=admin

# AEM as a Cloud Service settings
# AEM_URL=https://author-p<PROGRAM_ID>-e<ENV_ID>.adobeaemcloud.com
# AEM_SERVICE_CREDENTIALS_FILE=./service_credentials.json
